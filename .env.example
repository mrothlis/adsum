# Adsum — configuration
#
# Copy this file to .env and edit it:   cp .env.example .env
# Never commit .env; it is gitignored.
#
# Only the four settings in REQUIRED need changing to get started.


# ----------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------

# Signs session cookies and QR check-in tokens. The app refuses to start
# without a real one unless DEBUG=true. Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The first administrator, created automatically on an empty database.
ADMIN_EMAIL=admin@yourschool.edu
ADMIN_PASSWORD=

# Public address students' phones will reach, embedded in every QR code.
# Must be the external HTTPS URL in production, with no trailing slash.
BASE_URL=http://localhost:8000


# ----------------------------------------------------------------------
# INSTITUTION
# ----------------------------------------------------------------------

INSTITUTION_NAME=Your Institution

# Your Brightspace hostname, e.g. yourschool.brightspace.com. Check the
# address you actually sign in to; consortium-hosted sites differ.
D2L_HOST=

# Must match the key you enter on the D2L External Learning Tool link.
# The matching secret is generated on first run and shown in Settings.
LTI_CONSUMER_KEY=adsum


# ----------------------------------------------------------------------
# ATTENDANCE POLICY
# ----------------------------------------------------------------------

# Unexcused absences forgiven before the attendance grade is affected.
# Excused absences are always removed from the denominator entirely.
ALLOWED_UNEXCUSED_ABSENCES=3

# Minutes after a session starts before a check-in is recorded as late.
LATE_THRESHOLD_MINUTES=10

# Minutes a session accepts check-ins. Sessions do not auto-end; the
# instructor ends them explicitly.
CHECKIN_WINDOW_MINUTES=15


# ----------------------------------------------------------------------
# DISPLAY
# ----------------------------------------------------------------------

# Timestamps are stored as UTC and displayed in this zone.
# On Windows this needs the tzdata package, already in requirements.txt.
DISPLAY_TIMEZONE=America/New_York

# Used only if the IANA timezone database is unavailable.
DISPLAY_UTC_OFFSET_HOURS=-5


# ----------------------------------------------------------------------
# QR CHECK-IN
# ----------------------------------------------------------------------

# How often the displayed code changes, and how long a scanned token stays
# valid. Short values are what stop a screenshot being shared outside the
# room; raise them only if students struggle to scan in time.
QR_ROTATION_SECONDS=20
QR_TOKEN_EXPIRY_SECONDS=30


# ----------------------------------------------------------------------
# GEOFENCE DEFAULTS
# ----------------------------------------------------------------------

# Starting position of the map picker only — not a real classroom, and no
# geofence is enforced until an instructor enables it on a course. Set these
# to your campus so the map opens somewhere useful.
DEFAULT_GEOFENCE_LAT=0.0
DEFAULT_GEOFENCE_LON=0.0
DEFAULT_GEOFENCE_RADIUS_M=75


# ----------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------

HOST=0.0.0.0
PORT=8000

# Leave false outside local development: DEBUG shows tracebacks to users
# and disables the startup security checks.
DEBUG=false

# SQLite by default. For PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost/checkin
DATABASE_URL=sqlite+aiosqlite:///./adsum.db

# Creates a demo course with fictional students. Development only.
SEED_DEMO=false
