# CSU Check-In Configuration
# Copy this to .env and customize

# Secret key for session cookies and HMAC tokens (CHANGE THIS!)
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Database URL (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./csu_checkin.db

# Admin password for standalone mode
ADMIN_PASSWORD=admin123

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# QR Code settings
QR_ROTATION_SECONDS=20
QR_TOKEN_EXPIRY_SECONDS=30

# Geofence defaults (Columbus State University main campus)
DEFAULT_GEOFENCE_LAT=32.4600
DEFAULT_GEOFENCE_LON=-84.9877
DEFAULT_GEOFENCE_RADIUS_M=75

# Late threshold (minutes after session start)
LATE_THRESHOLD_MINUTES=10

# Base URL (set to your Cloudflare Tunnel domain for production)
BASE_URL=http://localhost:8000
# BASE_URL=https://your-host.example.edu

# D2L / LTI 1.1 Settings (configured per institution in the Settings page)
# No IT admin needed — instructors set up External Tool in D2L themselves.
# LTI_CONSUMER_KEY and LTI_CONSUMER_SECRET are set in the web UI.
