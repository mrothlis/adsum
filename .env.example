# Adsum — configuration
#
# Copy this file to .env and edit it:   cp .env.example .env
#                           Windows:   copy .env.example .env
# Never commit .env; it is gitignored.
#
# Only the four settings in REQUIRED need changing to get started.
#
# IMPORTANT: a real operating-system environment variable WINS over this file.
# The app loads .env without overriding what is already set, so a value
# exported in your shell, in a systemd unit, or in a scheduled task silently
# takes precedence over the line here. That is the first thing to check if a
# setting appears to have no effect.
#
# Two things are deliberately NOT here:
#   * the LTI consumer secret: it is generated on first start, stored in the
#     database, and shown and changed at /admin
#   * the attendance policy: it is per course, set by each instructor
#
# Do not add keys the app does not read. scripts/verify_install.py fails the
# build when .env.example and app/config.py disagree in either direction.
# (Windows deployments using start.ps1 may set PYTHON=<full path to python.exe>
# in their own .env; that is read by the launcher script, not by the app, so it
# belongs in .env and not in this file.)


# ----------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------

# Signs session cookies and QR check-in tokens. The app refuses to start
# without a real one unless DEBUG=true. Generate with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The first administrator, created automatically on an empty database.
ADMIN_EMAIL=admin@yourschool.edu
ADMIN_PASSWORD=

# Public address students' phones will reach, embedded in every QR code.
# Must be the external HTTPS URL in production, with no trailing slash.
BASE_URL=http://localhost:8000


# ----------------------------------------------------------------------
# INSTITUTION
# ----------------------------------------------------------------------

INSTITUTION_NAME=Your Institution

# Your Brightspace hostname, e.g. yourschool.brightspace.com. Check the
# address you actually sign in to; consortium-hosted sites differ.
D2L_HOST=

# Must match the key you enter on the D2L External Learning Tool link.
# The matching SECRET is not configured here: it is generated on first start,
# stored in the database, and shown at /admin (admin accounts only).
LTI_CONSUMER_KEY=adsum


# ----------------------------------------------------------------------
# ATTENDANCE POLICY -- not configured here
# ----------------------------------------------------------------------
#
# Forgiven absences, the late threshold and whether late counts as present
# are set per course by each instructor, in Course -> Settings -> Attendance
# Policy. They are deliberately not install settings: how many absences a
# student is allowed is a syllabus decision, not one for whoever runs the
# server.


# ----------------------------------------------------------------------
# DISPLAY
# ----------------------------------------------------------------------

# Timestamps are stored as UTC and displayed in this zone.
# On Windows this needs the tzdata package, already in requirements.txt.
DISPLAY_TIMEZONE=America/New_York

# Used only if the IANA timezone database is unavailable.
DISPLAY_UTC_OFFSET_HOURS=-5


# ----------------------------------------------------------------------
# QR CHECK-IN
# ----------------------------------------------------------------------

# How often the displayed code changes. A token stays valid for its own
# slot plus the previous one, so it lasts 20-40s. This is what stops a
# screenshot being shared outside the room; raise it only if students
# struggle to scan in time.
QR_ROTATION_SECONDS=20


# ----------------------------------------------------------------------
# GEOFENCE DEFAULTS
# ----------------------------------------------------------------------

# Starting position of the map picker only — not a real classroom, and no
# geofence is enforced until an instructor enables it on a course. Set these
# to your campus so the map opens somewhere useful.
DEFAULT_GEOFENCE_LAT=0.0
DEFAULT_GEOFENCE_LON=0.0
DEFAULT_GEOFENCE_RADIUS_M=75


# ----------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------

# Which network interface to listen on.
#
# WARNING: 0.0.0.0 means EVERY interface. On a laptop or a shared network
# that makes a "local try-out" reachable by anyone on the same LAN, over
# plain HTTP, with no certificate. The quick start tells you to open
# http://127.0.0.1:8000, which works either way, so if you only want it on
# this machine set:
#     HOST=127.0.0.1
# Keep 127.0.0.1 in production too when a reverse proxy on the same host is
# the only thing that should reach the app. Use 0.0.0.0 when the server must
# accept connections directly, for example behind a tunnel on another host.
HOST=0.0.0.0
PORT=8000

# Leave false outside local development: DEBUG shows tracebacks to users
# and disables the startup security checks.
DEBUG=false

# Addresses allowed to set X-Forwarded-For on this app's behalf, comma
# separated. Set it to the address your reverse proxy or tunnel connects
# from, usually 127.0.0.1 when it runs on the same machine. Leave it empty
# when the app is reached directly.
#
# This matters for the login throttle. If the header is trusted from anyone,
# the throttle can be bypassed by changing a header, and it can be used to
# lock a real user out by sending failed logins that claim to come from their
# address. Empty means trust nobody, which is the safe default.
TRUSTED_PROXY_IPS=

# SQLite, and today that is the only database that works.
#
# PostgreSQL is NOT supported yet, despite what older docs said. Three
# things are missing: asyncpg is not in requirements.txt; alembic/env.py
# builds a sync engine by stripping "+aiosqlite" from this URL, so an
# asyncpg URL fails there; and at least one migration compares a boolean to
# 0 in raw SQL, which PostgreSQL rejects. See the Limitations section of the
# README.
DATABASE_URL=sqlite+aiosqlite:///./adsum.db

# Creates a demo course with fictional students. Development only.
#
# Worth one deliberate run on a THROWAWAY database: a fresh install has no
# courses at all (they are created by the first D2L launch), so this is the
# only way to see the interface, take a practice session, and run the four
# test scripts that need a course with an enrolled student. Point
# DATABASE_URL at demo.db while you do it, then delete the file.
SEED_DEMO=false

# Apply pending database migrations at startup, taking a backup first.
# Leave this on unless your deployment runs migrations as its own step:
# with it off, an update that changes the schema will start the app against
# the old one and fail later, on whichever page touches a new column.
# SQLite only -- the backup uses SQLite's online backup API.
AUTO_MIGRATE=true

# Where backups are written. Default: backups/ next to the application.
#
# Set this when the application directory is not writable, which is the
# normal case in a container: the image is read-only and the database lives
# on a mounted volume, so the backups have to land on that volume too.
# Pointing it at a different disk is also the only way a backup survives
# losing the disk the database is on.
# BACKUP_DIR=/data/backups

# How many backups to keep. Older ones are pruned after each successful
# backup. Default 14.
# BACKUP_KEEP=14

# Where Adsum writes the .migration-failed marker. Default: next to the
# application. That marker is what stops a failed migration being retried on
# every restart, so it must live somewhere writable; set this to your data
# volume in a container.
# STATE_DIR=/data
