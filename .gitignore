# secrets & local state — never commit
.env
CREDENTIALS.txt
*.db
*.db-journal
*.db-wal
*.db-shm
backups/
server.log
# Written when a startup migration fails, so the launcher's retry loop stops
# attempting it. Local state about one machine's database, never shared.
.migration-failed

# python
__pycache__/
*.pyc
.venv/

# editor/OS
.vscode/
.idea/
Thumbs.db

# stale artifacts
*.bak
*.broken-*
new_lti_secret.tmp
